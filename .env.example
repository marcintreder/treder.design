# Neon Postgres — the blog's storage. Copy from the Neon console or Netlify env.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Shared secret Claude presents when publishing through the MCP endpoint.
# Generate with: openssl rand -hex 32
BLOG_API_TOKEN=""

# Password that unlocks the confidential (Google) case studies.
# Checked server-side; never shipped to the browser.
CASE_STUDY_PASSWORD=""

# Password for the /admin blog console (publish, unpublish, delete posts).
# Leave empty and the admin area stays locked for everyone — it fails closed.
ADMIN_PASSWORD=""

# Secret used to sign the unlock and admin session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""
