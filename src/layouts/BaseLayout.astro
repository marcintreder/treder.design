---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Dark pages (home, book, case studies) overlay a transparent header. */
  header?: 'dark' | 'light';
  /** Absolute or root-relative image for social cards. */
  ogImage?: string;
  /** Set for article pages so the correct Open Graph type is emitted. */
  article?: { publishedAt?: string | null; kind?: string };
}

const {
  title,
  description = site.description,
  header = 'light',
  ogImage = '/img/treder_keynote.webp',
  article,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/svg/treder.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0A0A0A" />

    <!-- The two weights above the fold; the rest stream in with font-display:swap. -->
    <link rel="preload" href="/fonts/39FEA2_2_0.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/39FEA2_5_0.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.title} />
    {article?.publishedAt && <meta property="article:published_time" content={article.publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="alternate" type="application/rss+xml" title={`${site.title} — Blog`} href="/rss.xml" />
    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader variant={header} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--gold);
        color: var(--ink);
        padding: 12px 20px;
        font-size: 13px;
        font-weight: var(--w-bold);
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
