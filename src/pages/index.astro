---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoCanvas from '../components/GeoCanvas.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import CaseRow from '../components/CaseRow.astro';
import { cases } from '../data/cases';
import { listPosts, formatDate, readingTime, kindLabel } from '../lib/posts';
import { autoExcerpt } from '../lib/markdown';

/**
 * The home page is fully prerendered: it is the most-hit, least-dynamic page on
 * the site, and nothing here depends on the request.
 *
 * Consequence worth knowing: the "Latest from the blog" list below is baked in
 * at build time, so publishing a post does not change this page until the next
 * build. /blog itself renders per-request and is always current.
 */
export const prerender = true;

const posts = await listPosts({ limit: 5 });
const featured = posts[0];
const recent = posts.slice(1, 5);

const topCases = cases.slice(0, 5);
---

<BaseLayout header="dark">
  {/* ------------------------------------------------------------------ hero */}
  <section class="section--black hero">
    <GeoCanvas />

    <div class="container hero__inner">
      <div class="hero__top">
        <span class="hero__role">Director of UX, Product &amp; Strategy · Google Play</span>
        <span class="hero__place">San Francisco Bay Area</span>
      </div>

      <h1 class="hero__wordmark">Marcin<br />Treder</h1>

      <div class="hero__cols">
        <div>
          <p class="label hero__label">Now</p>
          <p class="hero__text">Leading UX for over two billion gamers at Google Play.</p>
        </div>

        <div>
          <p class="label hero__label">Before</p>
          <p class="hero__text">Founding CEO of UXPin — bootstrapped to acquisition in 2020.</p>
        </div>

        <div>
          <p class="label hero__label">Writing</p>
          <p class="hero__text">
            <span class="hero__accent">The AI Handbook for Product Design</span> — how AI is
            transforming UX.
          </p>
        </div>

        <div class="hero__ctas">
          <a class="btn btn--gold" href="/blog">Read the blog</a>
          <a class="btn btn--ghost" href="/book">The book</a>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ newsletter */}
  <NewsletterSignup />

  {/* --------------------------------------------------- latest from the blog */}
  {
    featured && (
      <section class="section--dark latest">
        <div class="container latest__inner">
          <div class="latest__head">
            <div>
              <p class="eyebrow eyebrow--gold latest__eyebrow">Organized Musings</p>
              <h2 class="h2">Latest from the blog</h2>
            </div>
            <a class="latest__all" href="/blog">
              All writing &rarr;
            </a>
          </div>

          <div class="latest__grid">
            <a class="latest__featured" href={`/blog/${featured.slug}`}>
              {featured.coverImage ? (
                <img
                  class="latest__cover"
                  src={featured.coverImage}
                  alt=""
                  width="1200"
                  height="680"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="latest__cover latest__cover--placeholder" />
              )}

              <div class="latest__meta">
                <span class="latest__kind">{kindLabel(featured.kind)}</span>
                <span class="latest__date">
                  {formatDate(featured.publishedAt)} &middot; {readingTime(featured)}
                </span>
              </div>

              <h3 class="latest__title">{featured.title}</h3>
              <p class="latest__excerpt">{featured.excerpt ?? autoExcerpt(featured.bodyMd)}</p>
            </a>

            <div class="latest__list">
              {recent.map((post) => (
                <a class="latest__item" href={`/blog/${post.slug}`}>
                  <div class="latest__item-meta">
                    <span class="latest__item-kind">{kindLabel(post.kind).toUpperCase()}</span>
                    <span class="latest__item-date">{formatDate(post.publishedAt)}</span>
                  </div>
                  <h3 class="latest__item-title">{post.title}</h3>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* --------------------------------------------------------- book feature */}
  <section class="section--paper">
    <div class="container book">
      <div class="book__cover">
        <p class="book__imprint">Apress &middot; In progress</p>

        <div>
          <div class="book__mark" aria-hidden="true">
            <span class="book__mark-right"></span>
            <span class="book__mark-left"></span>
          </div>
          <p class="book__cover-title">The AI<br />Handbook<br />for Product<br />Design</p>
          <p class="book__cover-note">Working title</p>
        </div>

        <p class="book__author">Marcin Treder</p>
      </div>

      <div>
        <p class="eyebrow book__eyebrow">The Book</p>
        <h2 class="book__title">The AI Handbook for Product Design</h2>
        <p class="book__note">Working title</p>
        <p class="book__lede">How AI is transforming UX — and how UX shapes the future of AI.</p>
        <p class="book__body">
          A practical, conceptual guide for UX professionals, product managers and technologists
          building the next generation of AI-powered experiences. It goes deep into how AI actually
          works — from classical ML to RAG and agents — and connects it to real product and
          interaction practice.
        </p>
        <div class="btn-row book__ctas">
          <a class="btn btn--gold" href="/book">Explore the book</a>
          <a class="btn btn--ghost-light" href="/blog">Read the book notes</a>
        </div>
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------- selected work */}
  <section class="section--paper work rule-top">
    <div class="container work__inner">
      <div class="work__head">
        <h2 class="h2">Selected work</h2>
      </div>

      <div>
        {topCases.map((caseStudy) => <CaseRow caseStudy={caseStudy} variant="compact" />)}

        <a class="work__all" href="/portfolio">
          <span></span>
          <span></span>
          <span class="work__all-label">See all ten projects</span>
          <span class="work__all-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- about strip */}
  <section class="container about">
    <div class="about__grid">
      <figure class="about__figure">
        <img
          class="about__photo"
          src="/img/treder_keynote.webp"
          alt="Marcin Treder speaking on stage at Google Play Playtime"
          width="880"
          height="880"
          loading="lazy"
          decoding="async"
        />
        <span class="about__duotone" aria-hidden="true"></span>
        <span class="about__fade" aria-hidden="true"></span>
      </figure>

      <div>
        <p class="eyebrow about__eyebrow">About</p>
        <h2 class="about__title">Founder, builder, servant leader, forever student.</h2>
        <p class="about__body">
          17+ years leading teams at the intersection of user experience, product and engineering —
          from a founder-to-acquisition journey as CEO of UXPin, to senior leadership as a Director
          at Google. Recognized by MIT as a Top Innovator under 35.
        </p>
        <p class="about__body">
          A design practitioner at heart who still codes, now applying that blend to define the
          future of software through AI. Proud dad, guitarist of 25+ years, relentless tinkerer.
        </p>
        <a class="link-underline" href="/about">Learn more about me &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------------ hero */
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    padding-block: 132px 76px;
  }

  .hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule-dark);
  }

  .hero__role,
  .hero__place {
    font-size: 12px;
    font-weight: var(--w-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero__role {
    color: var(--gold);
  }

  .hero__place {
    color: var(--text-on-dark-faint);
  }

  .hero__wordmark {
    margin-top: 38px;
    font-weight: var(--w-black);
    font-size: var(--size-hero);
    line-height: 0.8;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .hero__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr) auto;
    gap: 40px;
    align-items: start;
    margin-top: 60px;
    padding-top: 34px;
    border-top: 1px solid var(--rule-dark);
  }

  .hero__label {
    margin-bottom: 12px;
  }

  .hero__text {
    font-size: 16px;
    font-weight: var(--w-light);
    line-height: 1.55;
    color: var(--text-on-dark-muted);
  }

  .hero__accent {
    color: var(--gold);
  }

  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-self: end;
  }

  .hero__ctas .btn {
    padding-inline: 26px;
  }

  @media (max-width: 1024px) {
    .hero__cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 860px) {
    .hero__inner {
      padding-block: 112px 76px;
    }

    .hero__cols {
      grid-template-columns: 1fr;
    }

    .hero__ctas {
      align-items: flex-start;
      align-self: start;
    }
  }

  /* --------------------------------------------------- latest from the blog */
  .latest__inner {
    padding-block: 96px 100px;
  }

  .latest__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 22px;
    margin-bottom: 48px;
    border-bottom: 1px solid var(--rule-dark);
  }

  .latest__eyebrow {
    margin-bottom: 14px;
  }

  .latest__all {
    font-size: 13px;
    font-weight: var(--w-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    white-space: nowrap;
    padding-bottom: 6px;
  }

  .latest__all:hover {
    color: var(--gold);
  }

  .latest__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .latest__featured {
    display: block;
    color: var(--text-on-dark);
    transition: opacity var(--t-fast);
  }

  .latest__featured:hover {
    opacity: 0.72;
    color: var(--text-on-dark);
  }

  .latest__cover {
    width: 100%;
    height: 340px;
    object-fit: cover;
  }

  .latest__cover--placeholder {
    background-image: repeating-linear-gradient(
      135deg,
      var(--ink-raised) 0 14px,
      var(--ink-raised-alt) 14px 28px
    );
  }

  .latest__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 26px 0 16px;
  }

  .latest__kind {
    background: var(--gold);
    color: var(--ink);
    font-size: 11px;
    font-weight: var(--w-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
  }

  .latest__date {
    font-size: 13px;
    color: var(--text-on-dark-faint);
  }

  .latest__title {
    margin-bottom: 16px;
    font-weight: var(--w-black);
    font-size: 34px;
    line-height: 1.05;
    letter-spacing: -0.015em;
    max-width: 20ch;
  }

  .latest__excerpt {
    font-size: 17px;
    font-weight: var(--w-light);
    line-height: 1.6;
    color: var(--text-on-dark-soft);
    max-width: 52ch;
  }

  .latest__list {
    display: flex;
    flex-direction: column;
  }

  .latest__item {
    display: block;
    padding-block: 22px;
    border-top: 1px solid var(--rule-dark);
    transition: opacity var(--t-fast);
  }

  .latest__item:hover {
    opacity: 0.72;
  }

  .latest__item-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .latest__item-kind {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--w-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  .latest__item-date {
    font-size: 12px;
    color: var(--text-on-dark-faint);
  }

  .latest__item-title {
    font-weight: var(--w-bold);
    font-size: 18px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text-on-dark);
  }

  @media (max-width: 860px) {
    .latest__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  /* ---------------------------------------------------------- book feature */
  .book {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 64px;
    align-items: center;
    padding-block: 90px;
  }

  .book__cover {
    aspect-ratio: 3 / 4;
    background: var(--ink-deep);
    border: 1px solid var(--rule-dark);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 36px;
  }

  .book__imprint,
  .book__cover-note {
    font-size: 11px;
    font-weight: var(--w-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-on-dark-faint);
  }

  .book__mark {
    position: relative;
    width: 56px;
    height: 56px;
    border: 2px solid var(--gold);
    margin-bottom: 28px;
  }

  .book__mark-right {
    position: absolute;
    inset: 10px 10px 10px 50%;
    background: var(--gold);
    border-radius: 0 100px 100px 0;
  }

  .book__mark-left {
    position: absolute;
    inset: 10px 50% 10px 10px;
    background: var(--rust);
    border-radius: 100px 0 0 100px;
  }

  .book__cover-title {
    font-weight: var(--w-black);
    font-size: 34px;
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--text-on-dark);
  }

  .book__cover-note {
    margin-top: 16px;
    letter-spacing: 0.16em;
  }

  .book__author {
    font-size: 13px;
    font-weight: var(--w-light);
    color: var(--text-on-dark-muted);
  }

  .book__eyebrow {
    margin-bottom: 22px;
  }

  .book__title {
    margin-bottom: 10px;
    font-weight: var(--w-black);
    font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .book__note {
    margin-bottom: 16px;
    font-size: 12px;
    font-weight: var(--w-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-on-light-soft);
  }

  .book__lede {
    margin-bottom: 28px;
    font-size: 19px;
    font-weight: var(--w-light);
    line-height: 1.4;
    color: var(--text-on-light-muted);
  }

  .book__body {
    margin-bottom: 34px;
    font-size: 17px;
    font-weight: var(--w-light);
    line-height: 1.7;
    color: var(--text-on-light-muted);
    max-width: 56ch;
  }

  .book__ctas {
    gap: 16px;
  }

  .book__ctas .btn {
    font-size: 13px;
  }

  @media (max-width: 860px) {
    .book {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .book__cover {
      max-width: 340px;
    }
  }

  /* -------------------------------------------------------- selected work */
  .work__inner {
    padding-block: 96px 100px;
  }

  .work__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 22px;
    margin-bottom: 10px;
    border-bottom: 1px solid var(--rule-light);
  }

  /* Mirrors CaseRow's compact grid so the label lines up with the case titles. */
  .work__all {
    display: grid;
    grid-template-columns: 64px 132px 1fr auto;
    gap: 28px;
    align-items: center;
    padding-block: 30px;
    border-bottom: 1px solid var(--rule-light);
    transition: background-color var(--t-fast);
  }

  .work__all:hover {
    background: var(--paper-hover);
  }

  .work__all-label {
    font-size: 15px;
    font-weight: var(--w-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rust);
  }

  .work__all-arrow {
    font-size: 22px;
    color: var(--gold);
  }

  @media (max-width: 860px) {
    .work__all {
      grid-template-columns: 120px 1fr;
      gap: 20px;
    }

    .work__all > :first-child,
    .work__all-arrow {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .work__all {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  /* ---------------------------------------------------------- about strip */
  .about {
    padding-block: 90px 110px;
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  /* `isolation` keeps the duotone blend inside the figure instead of letting it
     tint the page behind it. */
  .about__figure {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 440px;
    margin: 0;
    background: var(--ink-deep);
    overflow: hidden;
    isolation: isolate;
  }

  .about__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: grayscale(1) contrast(1.08) brightness(0.94);
  }

  .about__duotone,
  .about__fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .about__duotone {
    background: var(--gold);
    mix-blend-mode: color;
  }

  .about__fade {
    background: linear-gradient(180deg, rgb(10 10 10 / 0) 50%, rgb(10 10 10 / 0.5) 100%);
  }

  .about__eyebrow {
    margin-bottom: 22px;
  }

  .about__title {
    margin-bottom: 24px;
    font-weight: var(--w-black);
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .about__body {
    margin-bottom: 18px;
    font-size: 17px;
    font-weight: var(--w-light);
    line-height: 1.7;
    color: var(--text-on-light-muted);
    max-width: 54ch;
  }

  .about__body + .about__body {
    margin-bottom: 30px;
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
