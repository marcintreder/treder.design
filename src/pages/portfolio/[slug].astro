---
/**
 * A single case study.
 *
 * The whole route is server-rendered — one mode for every case, confidential or
 * not — because two of these cases are Google work that must never reach the
 * browser unless the request proves it is unlocked. The prototype compared the
 * password in client-side JS and shipped the protected copy regardless; here
 * the body is behind a real conditional, so a locked response simply does not
 * contain it.
 */
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseFigure from '../../components/CaseFigure.astro';
import { cases, getCase } from '../../data/cases';
import { elsewhere } from '../../lib/site';
import { isUnlocked, UNLOCK_COOKIE } from '../../lib/unlock';

/* No getStaticPaths(): the route is on-demand for every case, so Astro would
   only warn that it was ignored. `cases` is still the single source of valid
   slugs — anything else 404s below. */
const { slug } = Astro.params;
const caseStudy = slug ? getCase(slug) : undefined;

if (!caseStudy) {
  return new Response('Case study not found', { status: 404 });
}

let unlocked = true;
if (caseStudy.confidential) {
  try {
    unlocked = await isUnlocked(Astro.cookies.get(UNLOCK_COOKIE)?.value);
  } catch {
    // No signing secret configured — fail closed rather than leaking the body.
    unlocked = false;
  }
  // Never let a CDN or shared cache hand an unlocked page to the next visitor.
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('Vary', 'Cookie');
}

const locked = !unlocked;
const showError = Astro.url.searchParams.get('error') === '1';

const meta = `${caseStudy.org} · ${caseStudy.years}`;
const index = cases.findIndex((c) => c.slug === caseStudy.slug);
const nextCase = cases[(index + 1) % cases.length];
const heroMode = caseStudy.heroMode;
---

<BaseLayout
  title={caseStudy.title}
  description={locked ? `${caseStudy.title} — a protected case study.` : caseStudy.lede}
  header="dark"
  ogImage={unlocked ? (caseStudy.hero ?? undefined) : undefined}
>
  <section class="section--black hero">
    <div class="container hero__inner">
      <div class="hero__top">
        <a class="hero__back" href="/portfolio">&larr; Portfolio</a>
        <span class="hero__meta">{meta}</span>
      </div>

      <h1 class="hero__title">{caseStudy.title}</h1>

      <div class:list={['hero__foot', locked && 'hero__foot--bare']}>
        {unlocked && <p class="hero__lede">{caseStudy.lede}</p>}
        <p class="hero__role">{caseStudy.role}</p>
      </div>
    </div>
  </section>

  {
    locked && (
      <section class="container gate">
        <div class="gate__card">
          <span class="gate__lock" aria-hidden="true" />
          <h2 class="gate__title">This case study is protected</h2>
          <p class="gate__copy">
            Work done at Google is shared privately. Enter the password to read it, or <a
              href={elsewhere.linkedin}
              target="_blank"
              rel="noopener noreferrer">ask me for access</a
            >.
          </p>

          <form class="gate__form" method="post" action="/api/unlock">
            <input type="hidden" name="redirect" value={Astro.url.pathname} />
            <label class="gate__label" for="case-password">
              Password
            </label>
            <input
              class="gate__input"
              id="case-password"
              name="password"
              type="password"
              placeholder="Password"
              autocomplete="current-password"
              required
            />
            <button class="btn btn--dark" type="submit">Unlock</button>
          </form>

          {
            showError && (
              <p class="gate__error" role="alert">
                That password is not right. Try again.
              </p>
            )
          }
        </div>
      </section>
    )
  }

  {
    unlocked && caseStudy.hero && (
      <section class="section--black heroimg">
        <div class="container">
          <div class:list={['heromedia', `heromedia--${heroMode}`]}>
            <img class="heromedia__img" src={caseStudy.hero} alt={caseStudy.title} decoding="async" />
          </div>
        </div>
      </section>
    )
  }

  {
    unlocked && caseStudy.stats.length > 0 && (
      <section class="container stats">
        <div class="card-strip stats__grid">
          {caseStudy.stats.map((stat) => (
            <div class="stats__cell">
              <div class="stats__value">{stat.v}</div>
              <div class="stats__label">{stat.l}</div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    unlocked && (
      <section class="container body">
        {caseStudy.sections.map((section) => (
          <article class="sec">
            <h2 class="sec__heading">{section.h}</h2>
            <div class="sec__body">
              {section.p.map((para) => (
                <p class="sec__p">{para}</p>
              ))}
              {section.figs.length > 0 && (
                <div class="sec__figs">
                  {section.figs.map((figure) => (
                    <CaseFigure figure={figure} />
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </section>
    )
  }

  {
    unlocked && caseStudy.lessons.length > 0 && (
      <section class="section--dark lessons">
        <div class="container lessons__inner">
          <p class="eyebrow eyebrow--gold lessons__eyebrow">Lessons learned</p>
          <ul class="lessons__list">
            {caseStudy.lessons.map((lesson) => (
              <li class="lessons__item">{lesson}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    unlocked && (
      <section class="container next">
        <a class="next__row" href={`/portfolio/${nextCase.slug}`}>
          <span class="next__thumb">
            {nextCase.hero && (
              <img class="next__img" src={nextCase.hero} alt="" loading="lazy" decoding="async" />
            )}
          </span>
          <div class="next__text">
            <span class="label next__label">Next project</span>
            <h2 class="next__title">{nextCase.title}</h2>
            <span class="next__meta">
              {nextCase.org} · {nextCase.years} · {nextCase.role}
            </span>
          </div>
          <span class="next__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <p class="next__all">
          <a class="next__alllink" href="/portfolio">&larr; All work</a>
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ------------------------------------------------------------------ hero */
  .hero__inner {
    padding-block: 150px 76px;
  }

  .hero__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 20px;
    margin-bottom: 38px;
    border-bottom: 1px solid var(--rule-dark);
  }

  .hero__back {
    font-size: 12px;
    font-weight: var(--w-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .hero__back:hover {
    color: var(--text-on-dark);
  }

  .hero__meta {
    font-size: 12px;
    font-weight: var(--w-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-on-dark-faint);
    text-align: right;
  }

  .hero__title {
    /* Its own ramp — case titles run a touch smaller than the page-title ramp. */
    margin: 0 0 -0.16em -4px;
    font-size: clamp(36px, 6.4vw, 104px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-weight: var(--w-black);
    color: var(--text-on-dark);
  }

  .hero__foot {
    margin-top: 38px;
    padding-top: 34px;
    border-top: 1px solid var(--rule-dark);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 56px;
    align-items: end;
  }

  .hero__foot--bare {
    grid-template-columns: 1fr;
  }

  .hero__lede {
    max-width: 56ch;
    font-size: 19px;
    font-weight: var(--w-light);
    line-height: 1.6;
    color: var(--text-on-dark-muted);
  }

  .hero__role {
    font-size: 13px;
    color: var(--text-on-dark-faint);
    letter-spacing: 0.04em;
    text-align: right;
    max-width: 28ch;
  }

  .hero__foot--bare .hero__role {
    text-align: left;
  }

  /* ------------------------------------------------------------ hero image */
  .heroimg {
    padding-bottom: 70px;
  }

  .heromedia {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--ink);
  }

  .heromedia__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .heromedia--contain {
    border: 1px solid var(--rule-dark);
  }

  /* Line art and logotypes get a near-white ground and generous side margins. */
  .heromedia--light {
    background-color: var(--paper);
    padding-inline: 10%;
  }

  /* Framed and tall heroes float the artwork on a dark stage instead. */
  .heromedia--framed,
  .heromedia--tall {
    aspect-ratio: auto;
    display: flex;
    justify-content: center;
    border: 1px solid var(--rule-dark);
  }

  .heromedia--framed {
    padding: 56px 40px;
  }

  .heromedia--tall {
    padding: 44px 20px;
  }

  .heromedia--framed .heromedia__img {
    width: 100%;
    max-width: 780px;
    height: auto;
    aspect-ratio: 780 / 510;
    box-shadow: 0 30px 70px rgb(0 0 0 / 0.6);
  }

  .heromedia--tall .heromedia__img {
    width: min(320px, 60vw);
    height: auto;
    aspect-ratio: 9 / 19.5;
    filter: drop-shadow(0 30px 50px rgb(0 0 0 / 0.6));
  }

  /* ----------------------------------------------------------------- stats */
  .stats {
    padding-block: 70px 20px;
  }

  .stats__grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .stats__cell {
    padding: 32px 26px;
  }

  .stats__value {
    font-weight: var(--w-black);
    font-size: clamp(24px, 2.4vw, 34px);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .stats__label {
    font-size: 13px;
    color: var(--text-on-light-soft);
    margin-top: 10px;
    line-height: 1.4;
  }

  /* -------------------------------------------------------------- sections */
  .body {
    padding-block: 50px 40px;
  }

  .sec {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 56px;
    padding: 44px 0;
    border-top: 1px solid var(--rule-light);
  }

  .sec__heading {
    font-weight: var(--w-black);
    font-size: 26px;
    letter-spacing: -0.02em;
    position: sticky;
    top: 110px;
    align-self: start;
  }

  .sec__p {
    font-size: 18px;
    font-weight: var(--w-light);
    line-height: 1.75;
    color: var(--text-on-light-muted);
    max-width: 62ch;
  }

  .sec__p + .sec__p {
    margin-top: 22px;
  }

  .sec__figs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin-top: 34px;
  }

  /* --------------------------------------------------------------- lessons */
  .lessons {
    margin-top: 40px;
  }

  .lessons__inner {
    padding-block: 80px;
  }

  .lessons__eyebrow {
    margin-bottom: 44px;
  }

  .lessons__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lessons__item {
    padding: 30px 0;
    border-top: 1px solid var(--rule-dark);
    font-weight: var(--w-light);
    font-size: clamp(22px, 2.8vw, 38px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-on-dark);
    max-width: 24ch;
  }

  /* ------------------------------------------------------------ next case */
  .next {
    padding-block: 60px 90px;
  }

  .next__row {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 36px;
    align-items: center;
    padding: 36px 0;
    border-top: 1px solid var(--rule-light);
    border-bottom: 1px solid var(--rule-light);
    color: var(--text-on-light);
    transition: background-color var(--t-fast);
  }

  .next__row:hover {
    background: var(--paper-hover);
    color: var(--text-on-light);
  }

  .next__thumb {
    display: block;
    height: 120px;
    border: 1px solid var(--rule-light);
    background-color: var(--paper-sand);
  }

  .next__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .next__text {
    display: block;
  }

  .next__label {
    display: block;
    color: var(--rust);
    margin-bottom: 14px;
  }

  .next__title {
    font-weight: var(--w-black);
    font-size: clamp(22px, 2.8vw, 36px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .next__meta {
    display: block;
    font-size: 14px;
    color: var(--text-on-light-soft);
    letter-spacing: 0.02em;
  }

  .next__arrow {
    font-size: 26px;
    color: var(--gold);
  }

  .next__all {
    padding-top: 28px;
  }

  .next__alllink {
    font-size: 14px;
    font-weight: var(--w-medium);
    letter-spacing: 0.04em;
    color: var(--text-on-light);
  }
  .next__alllink:hover {
    color: var(--rust);
  }

  /* ------------------------------------------------------------ password gate */
  .gate {
    padding-block: 90px 110px;
  }

  .gate__card {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    border: 1px solid var(--rule-light);
    padding: 56px 44px;
    background: var(--paper-hover);
  }

  /* A padlock body drawn from the box itself plus its shackle-less keyway bar. */
  .gate__lock {
    display: block;
    position: relative;
    width: 44px;
    height: 44px;
    border: 2px solid var(--rust);
    margin: 0 auto 26px auto;
  }

  .gate__lock::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 11px;
    bottom: 11px;
    width: 2px;
    background: var(--rust);
    transform: translateX(-50%);
  }

  .gate__title {
    font-weight: var(--w-black);
    font-size: 28px;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .gate__copy {
    margin-bottom: 30px;
    font-size: 16px;
    font-weight: var(--w-light);
    line-height: 1.65;
    color: var(--text-on-light-muted);
  }

  .gate__form {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .gate__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .gate__input {
    flex: 1;
    min-width: 220px;
    border: 1px solid var(--border-input);
    background: var(--paper);
    padding: 0 16px;
    min-height: 52px;
    font-family: inherit;
    font-size: 15px;
    color: var(--text-on-light);
  }

  .gate__error {
    margin-top: 18px;
    font-size: 14px;
    font-weight: var(--w-medium);
    color: var(--rust);
  }

  /* ------------------------------------------------------------ responsive */
  @media (max-width: 1024px) {
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 860px) {
    .hero__inner {
      padding-block: 118px 60px;
    }

    .hero__foot {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .hero__role {
      text-align: left;
    }

    .sec {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .sec__heading {
      position: static;
    }

    .next__row {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .next__arrow {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .stats__grid {
      grid-template-columns: 1fr;
    }

    .sec {
      gap: 20px;
    }

    .gate__card {
      padding: 40px 24px;
    }

    .gate__form > .gate__input,
    .gate__form > .btn {
      flex: 1 1 100%;
    }
  }
</style>
