---
/**
 * The sacred-geometry field behind the dark hero: concentric hairlines, a
 * vesica pair, counter-rotating polygons and radial spokes. Drifts on its own,
 * leans toward the pointer, and speeds up briefly while the page scrolls.
 *
 * Ported from the prototype's componentDidMount. Purely decorative, so it is
 * aria-hidden and skipped entirely when the visitor prefers reduced motion.
 */
---

<canvas class="geo" aria-hidden="true"></canvas>

<style>
  .geo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: block;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.geo');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduced) {
    const ctx = canvas.getContext('2d');

    if (ctx) {
      let w = 0;
      let h = 0;
      let spin = 0;
      let boost = 0;
      let raf = 0;
      let lastScroll = window.scrollY;

      const target = { x: 0.5, y: 0.5 };
      const eased = { x: 0.5, y: 0.5 };

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        if (!r.width || !r.height) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = r.width;
        h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const onMove = (e: MouseEvent) => {
        const r = canvas.getBoundingClientRect();
        target.x = (e.clientX - r.left) / r.width;
        target.y = (e.clientY - r.top) / r.height;
      };

      const onScroll = () => {
        const y = window.scrollY;
        boost = Math.min(boost + Math.abs(y - lastScroll) * 0.00022, 0.05);
        lastScroll = y;
      };

      const poly = (cx: number, cy: number, radius: number, sides: number, rot: number) => {
        ctx.beginPath();
        for (let i = 0; i <= sides; i++) {
          const a = rot + (i / sides) * Math.PI * 2;
          const x = cx + Math.cos(a) * radius;
          const y = cy + Math.sin(a) * radius;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      };

      const draw = () => {
        raf = requestAnimationFrame(draw);
        if (!w || !h) {
          resize();
          if (!w || !h) return;
        }

        boost *= 0.94;
        spin += 0.0016 + boost;
        eased.x += (target.x - eased.x) * 0.085;
        eased.y += (target.y - eased.y) * 0.085;

        ctx.clearRect(0, 0, w, h);
        ctx.lineWidth = 1;

        const cx = w * 0.72 + (eased.x - 0.5) * 260;
        const cy = h * 0.5 + (eased.y - 0.5) * 190;
        const pull = Math.hypot(eased.x - 0.5, eased.y - 0.5);
        const base = Math.min(w, h) * 0.42 * (1 + pull * 0.28);
        const tilt = (eased.x - 0.5) * 2.2 + (eased.y - 0.5) * 0.9;

        // concentric hairline circles
        for (let i = 0; i < 5; i++) {
          ctx.strokeStyle = `rgba(231,173,122,${0.11 - i * 0.012})`;
          ctx.beginPath();
          ctx.arc(cx, cy, base * (0.42 + i * 0.19), 0, Math.PI * 2);
          ctx.stroke();
        }

        // vesica — two offset circles
        ctx.strokeStyle = 'rgba(231,173,122,0.075)';
        for (const dir of [-1, 1]) {
          ctx.beginPath();
          ctx.arc(cx + dir * base * 0.34, cy, base * 0.72, 0, Math.PI * 2);
          ctx.stroke();
        }

        // counter-rotating polygons
        ctx.strokeStyle = 'rgba(231,173,122,0.13)';
        poly(cx, cy, base * 0.86, 6, spin * 1.6 + tilt);
        ctx.strokeStyle = 'rgba(231,173,122,0.10)';
        poly(cx, cy, base * 0.62, 3, -spin * 2.4 - tilt * 1.6);
        poly(cx, cy, base * 0.62, 3, -spin * 2.4 - tilt * 1.6 + Math.PI);
        ctx.strokeStyle = 'rgba(126,71,23,0.20)';
        poly(cx, cy, base * 1.12, 12, spin * 0.9 + tilt * 0.5);

        // radial spokes
        ctx.strokeStyle = 'rgba(231,173,122,0.055)';
        for (let i = 0; i < 12; i++) {
          const a = (i / 12) * Math.PI * 2 + spin * 0.7;
          ctx.beginPath();
          ctx.moveTo(cx + Math.cos(a) * base * 0.34, cy + Math.sin(a) * base * 0.34);
          ctx.lineTo(cx + Math.cos(a) * base * 1.12, cy + Math.sin(a) * base * 1.12);
          ctx.stroke();
        }
      };

      resize();
      window.addEventListener('resize', resize);
      window.addEventListener('mousemove', onMove);
      window.addEventListener('scroll', onScroll, { passive: true });

      // Stop burning frames when the hero scrolls out of view or the tab hides.
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && !raf) raf = requestAnimationFrame(draw);
        else if (!entry.isIntersecting && raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      });
      io.observe(canvas);
    }
  }
</script>
